    {
      "parameters": {
        "jsCode": "const notionRows = $('Notion조회').all();\nconst fcItems    = $('Firecrawl본문').all();\nconst promptItems = $input.all();   // 프롬프트읽기 출력 (각 item에 binary)\n\nconst out = [];\nfor (let i = 0; i < promptItems.length; i++) {\n  const pkey = Object.keys(promptItems[i].binary || {})[0];\n  let prompt = (await this.helpers.getBinaryDataBuffer(i, pkey)).toString('utf-8');\n  prompt = prompt.replace(/^---[\\s\\S]*?---\\s*/, '').trim();   // frontmatter 제거\n\n  const props = notionRows[i].json.properties;\n  const fc    = fcItems[i].json;\n  const user_content =\n    `channel.name: ${props.Channel?.select?.name || ''}\\n` +\n    `channel.domain: ${props.Domain?.multi_select?.[0]?.name || ''}\\n` +\n    `title: ${props.Title?.title?.[0]?.plain_text || ''}\\n` +\n    `url: ${props.URL?.url || ''}\\n\\n` +\n    `body_markdown:\\n${((fc.data && fc.data.markdown) || '').slice(0, 12000)}`;\n\n  out.push({ json: {\n    system: prompt,\n    user_content,\n    _pageId: notionRows[i].json.id,\n    _title: props.Title?.title?.[0]?.plain_text || '',\n    _url: props.URL?.url || '',\n  }});\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        48
      ],
      "id": "17da300f-2e0d-4d5e-ad25-fb38ff07cb65",
