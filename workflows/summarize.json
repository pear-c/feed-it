      "id": "e8912916-7073-42e0-9671-72799c1385b6",
      "name": "Claude요약",
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "OuI3Efz8v0rjtLf3",
          "name": "Header Auth account"
        },
        "anthropicApi": {
          "id": "7ZsUMGRBAlZbAmV8",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ins  = $input.all();             // Claude 응답들\nconst meta = $('payload빌드S').all();  // _pageId 등\nconst out = [];\nfor (let i = 0; i < ins.length; i++) {\n  let text = ((ins[i].json.content && ins[i].json.content[0] && ins[i].json.content[0].text) || '').trim();\n  text = text.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  const m = meta[i].json;\n  try {\n    const obj = JSON.parse(text);\n    obj.summary_short = String(obj.summary_short || '').slice(0, 250);\n    if (!Array.isArray(obj.tags)) obj.tags = [];\n    obj.author = obj.author || '';\n    obj.summary_long = obj.summary_long || '';\n    out.push({ json: { ...obj, _pageId: m._pageId, _title: m._title, _url: m._url } });\n  } catch (e) {\n    out.push({ json: { _parse_error: e.message, raw: text.slice(0, 500), _pageId: m._pageId, _title: m._title, _url:\nm._url } });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        48
      ],
      "id": "db472eb8-aa87-4e33-bb51-d9972c4818c1",
      "name": "JSON파싱S"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((it) => {\n  const o = it.json;\n  const long = o.summary_long || o.summary_short || '(요약 없음)';\n  const chunks = [];\n  for (let i = 0; i < long.length; i += 1500) chunks.push(long.slice(i, i + 1500));\n  const blocks = chunks.map((c) => ({\n    object: 'block', type: 'paragraph',\n    paragraph: { rich_text: [{ type: 'text', text: { content: c } }] },\n  }));\n  const _tagsML = (o.tags || []).map((t) => ({ name: String(t) }));   // ← 추가\n  return { json: { ...o, _blocks: blocks, _tagsML } };\n});"
      },
